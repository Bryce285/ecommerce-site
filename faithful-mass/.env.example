# Template for .env — copy to .env and fill in. Safe to commit.
# Schema and types are declared in astro.config.mjs (env.schema).

# Resend API key, from https://resend.com (starts with "re_").
# Requires a verified sending domain to mail anyone but yourself.
RESEND_API_KEY=

# Destination address for contact and support form submissions.
CONTACT_TO_EMAIL=

# Turnstile keys from the Cloudflare dashboard.
# For local work, Cloudflare's test pair needs no account:
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
