---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | Company Name" description="Get in touch with Company Name.">
    <Header />
    <div class="flex flex-col items-center">
        <div
            class="bg-black w-1/2 min-h-screen flex flex-col px-12 pb-12 pt-20"
        >
            <h1 class="font-display uppercase tracking-[-0.03em] text-[3.0vw]">
                Contact
            </h1>
            <ContactForm
                topic="contact"
                messageLabel="Message"
                submitLabel="Submit Message"
            />
        </div>
    </div>
    <Footer />
</Layout>
