---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import ProductBgPhoto from '../assets/Product_BG_Image.png';
import ProductPhoto from '../assets/Product_Image.png';
import Image from 'astro/components/Image.astro';
import MouseBackground from '../components/MouseBackground';
import { products } from '../lib/mock-data';
import { formatPrice } from '../lib/format';
---

<Layout title="Company Name" description="A short description of your company and what it offers.">
	<Header />
	<div class="relative bg-black w-screen h-[100vh] min-h-150 -mt-25 overflow-hidden flex flex-col justify-center items-center pt-12">
		<MouseBackground client:load />
		<h1 class="relative font-display uppercase text-white w-full whitespace-nowrap text-center leading-none tracking-[-0.03em] text-[8.83vw]">
			WE MAKE
		</h1>
		<h1 class="relative font-display uppercase text-[#00A5CF] w-full whitespace-nowrap text-center leading-none tracking-[-0.03em] text-[10.83vw]">
			PRODUCTS
		</h1>
		<h1 class="relative font-display uppercase text-white w-full whitespace-nowrap text-center leading-none tracking-[-0.03em] text-[8.83vw]">
			SO YOU CAN
		</h1>
		<h1 class="relative font-display uppercase text-white w-full whitespace-nowrap text-center leading-none tracking-[-0.03em] text-[10.83vw]">
			DO MORE.
		</h1>
	</div>
	{products.map((product, i) => (
		<div class="relative w-screen h-[100vh] min-h-150 overflow-hidden">
			<Image
				src={ProductBgPhoto}
				alt=""
				widths={[640, 1024, 1600, 2000, 2400]}
				sizes="100vw"
				loading={i === 0 ? 'eager' : 'lazy'}
				fetchpriority={i === 0 ? 'high' : 'auto'}
				class="absolute inset-0 w-full h-full object-cover"
			/>
			<div class="absolute inset-0 z-10 flex items-center justify-center gap-8 px-8 lg:px-16">
				<div class="flex-1 max-w-xs text-left">
					<h2 class="font-display uppercase text-white text-[2.0vw] leading-none tracking-[-0.02em]">
						{product.name}
					</h2>
					<p class="mt-4 text-white/80 text-sm leading-relaxed">
						{product.description} {formatPrice(product.priceCents, product.currency)}.
					</p>
					<a href={`/products/${product.slug}`} class="inline-block border border-white mt-4 p-2 hover:bg-gray-50/20">More</a>
				</div>
				<Image
					src={ProductPhoto}
					alt={product.name}
					widths={[320, 480, 640, 800]}
					sizes="40vw"
					loading={i === 0 ? 'eager' : 'lazy'}
					fetchpriority={i === 0 ? 'high' : 'auto'}
					class="w-2/5 h-auto shrink-0"
				/>
				<div class="flex-1 max-w-xs text-right">
					<h2 class="font-display uppercase text-white text-[2.0vw] leading-none tracking-[-0.02em]">
						{product.tagline}
					</h2>
				</div>
			</div>
		</div>
	))}
	<Footer />
</Layout>
