---
import Logo from '../assets/Logo.svg';
---

<footer class="min-h-90 flex flex-col items-center pt-12 bg-black">
    <nav class="flex items-start justify-center gap-8 md:gap-24 lg:gap-30 w-full relative z-10">
        <div>
            <a href="/" class="block w-fit">
                <img src={Logo.src} alt="Company logo" class="h-8 w-auto">
            </a>
            <p class="mt-5">A short company description goes here.</p>
        </div>

        <div class="w-px shrink-0 self-stretch bg-gray-600"></div>

        <div class="flex flex-col items-start gap-2">
            <!-- Same height as the logo image, so bottom-aligning the text inside puts it
                 on the logo's bottom edge. Leading is 1 so the line box hugs the glyphs. -->
            <h1 class="text-2xl/none flex h-8 items-end mb-2">Info</h1>
            <a href="/about" class="hover:text-gray-300">About</a>
            <a href="/faq" class="hover:text-gray-300">Support/FAQ</a>
            <a href="/contact" class="hover:text-gray-300">Contact</a>
            <a href="/policies/privacy-policy" class="hover:text-gray-300">Privacy Policy</a>
            <a href="/policies/terms-of-service" class="hover:text-gray-300">Terms of Service</a>
        </div>
    </nav>
    <div class="mt-12 flex gap-6 text-sm">
        <a href="#" class="hover:text-gray-300">Instagram</a>
        <a href="#" class="hover:text-gray-300">YouTube</a>
        <a href="#" class="hover:text-gray-300">X</a>
    </div>
    <p class="mt-4 mb-8 text-sm">&copy; 2026 Company Name. All rights reserved.</p>
</footer>